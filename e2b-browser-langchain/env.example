# E2B Browser Sandbox
E2B_API_KEY=e2b_xxx
# Optional endpoint settings for E2B-compatible regional deployments.
E2B_API_URL=
E2B_DOMAIN=
# Browser image used to build a temporary template for each run.
E2B_BROWSER_IMAGE=fc-e2b-registry.us-west-1.cr.aliyuncs.com/runtime/browser:v0.0.32
E2B_TIMEOUT=600

# Any OpenAI-compatible chat-completions provider
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
