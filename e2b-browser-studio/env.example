# Alibaba Cloud E2B browser sandbox. All three values are required.
E2B_API_KEY=e2b_xxx
E2B_API_URL=https://api.us-west-1.e2b.fc.aliyuncs.com
E2B_DOMAIN=us-west-1.e2b.fc.aliyuncs.com
E2B_TEMPLATE=
E2B_BROWSER_IMAGE=fc-e2b-registry.us-west-1.cr.aliyuncs.com/runtime/browser:v0.0.32
E2B_TIMEOUT=600

# OpenAI-compatible model provider
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Local API / frontend
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8000
STUDIO_CORS_ORIGINS=http://localhost:5173
