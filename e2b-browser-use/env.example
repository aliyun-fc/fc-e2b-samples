# E2B sandbox credentials
E2B_API_KEY=e2b_xxx
E2B_API_URL=https://api.us-west-1.e2b.fc.aliyuncs.com
E2B_DOMAIN=us-west-1.e2b.fc.aliyuncs.com

# Optional: reuse an existing E2B browser template. When unset, the demo builds
# a temporary template from E2B_BROWSER_IMAGE.
E2B_TEMPLATE=
E2B_TIMEOUT=600
E2B_BROWSER_IMAGE=fc-e2b-registry.us-west-1.cr.aliyuncs.com/runtime/browser:v0.0.32

# Any OpenAI-compatible chat-completions endpoint
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# BrowserUse behavior
BROWSER_USE_VISION=true
USER_ID=default_user
SESSION_ID=default_session
THREAD_ID=default_thread
