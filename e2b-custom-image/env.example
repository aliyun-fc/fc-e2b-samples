# Alibaba Cloud E2B. 三个都必填，SDK 自动从环境变量读取。
E2B_API_KEY=e2b_xxx
E2B_API_URL=https://api.us-west-1.e2b.fc.aliyuncs.com
E2B_DOMAIN=us-west-1.e2b.fc.aliyuncs.com

# 沙箱存活时长（秒），run.py 用，默认 900。
E2B_TIMEOUT=900

# 镜像地址：两项都必填，换成你自己的 ACR。IMAGE 走公网供 docker push，
# FROM_IMAGE 走 VPC 供 e2b 构建服务拉取。build.py 用。
# 地域必须和上面的 API_URL/DOMAIN 一致（这里是 us-west-1）：direct 模式下
# 构建服务只能从同地域 VPC 拉取镜像，跨地域会导致模板不可见或构建失败。
E2B_IMAGE=your-registry.us-west-1.cr.aliyuncs.com/your-repo/envd-custom-debian:v1
E2B_FROM_IMAGE=your-registry-vpc.us-west-1.cr.aliyuncs.com/your-repo/envd-custom-debian:v1

# 模板名（同名只能构建一次，重建要换名）及构建资源。build.py / run.py 用。
E2B_TEMPLATE_NAME=envd-custom-debian-4c8g-v1
E2B_TEMPLATE_CPU=4
E2B_TEMPLATE_MEMORY_MB=8192
