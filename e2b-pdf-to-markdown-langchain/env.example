# E2B API configuration (required by template build and PDF conversion).
E2B_API_KEY=e2b_xxx
E2B_API_URL=https://api.us-west-1.e2b.fc.aliyuncs.com
E2B_DOMAIN=us-west-1.e2b.fc.aliyuncs.com
E2B_TIMEOUT=600

# Template-build configuration.
E2B_TEMPLATE_IMAGE=fc-e2b-dev-registry.us-west-1.cr.aliyuncs.com/custom/document-conversion-template:0.0.1
# Set both variables only when the E2B control plane needs private-image credentials.
E2B_TEMPLATE_SOURCE_USERNAME=
E2B_TEMPLATE_SOURCE_PASSWORD=
E2B_TEMPLATE_CPU=2
E2B_TEMPLATE_MEMORY_MB=2048
# Set this to the value printed by `python build_template.py`.
E2B_TEMPLATE_ID=

# OpenAI-compatible model configuration (required when not using --direct).
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
